<view class="meal-card {{tone}}">
  <view class="meal-topline">
    <view class="meal-mark"></view>
    <text class="meal-label">{{meal.label}}</text>
    <view wx:if="{{editable}}" class="edit-action touch-target" bindtap="edit" hover-class="edit-hover" aria-role="button" aria-label="调整这顿餐">调整</view>
  </view>
  <text class="meal-title">{{meal.title}}</text>
  <text wx:if="{{meal.quantityBasis === 'total'}}" class="meal-conditions">{{meal.servings}} 人总用量 · {{meal.estimatedCookingMinutes ? '预计 ' + meal.estimatedCookingMinutes + ' 分钟（含备料）' : '做法或食材已调整，耗时待核对'}}</text>
  <text class="meal-ingredients">{{meal.ingredients}}</text>
  <view class="meal-divider"></view>
  <text class="meal-method">{{meal.method}}</text>
  <text class="meal-tag">{{meal.tag}}</text>
  <text wx:if="{{meal.personalized}}" class="personal-tag">我的方案</text>
  <button wx:if="{{replaceable}}" class="replace-action" bindtap="replace" hover-class="edit-hover" aria-label="为{{meal.label}}生成单餐候选，预览确认后生效">这顿换一个</button>
  <button wx:if="{{favoritable}}" class="replace-action" bindtap="favorite" hover-class="edit-hover" aria-label="查看并收藏当前{{meal.label}}副本">收藏这餐</button>
</view>
