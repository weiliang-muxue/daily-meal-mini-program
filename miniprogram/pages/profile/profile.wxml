<view class="screen">
  <view class="profile-header surface">
    <button wx:if="{{avatarPrivacyMode === 'native'}}" class="avatar-button" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar" disabled="{{profileLoading || saving}}" aria-label="更换头像">
      <view class="avatar-visual">
        <image wx:if="{{avatarPreview && !avatarImageFailed}}" class="avatar" src="{{avatarPreview}}" data-src="{{avatarPreview}}" binderror="onAvatarImageError" mode="aspectFill" />
        <view wx:else class="avatar avatar-empty"><text>{{nicknameInitial}}</text></view>
        <view class="avatar-edit-icon" aria-hidden="true"><image src="/assets/icons/tabbar/profile.png" mode="aspectFit" /></view>
      </view>
      <text class="avatar-action">更换头像</text>
    </button>
    <button wx:else class="avatar-button avatar-authorize" bindtap="authorizeAvatarPrivacy" loading="{{authorizingAvatar}}" disabled="{{profileLoading || authorizingAvatar || saving}}" aria-label="授权后更换头像">
      <view class="avatar-visual">
        <image wx:if="{{avatarPreview && !avatarImageFailed}}" class="avatar" src="{{avatarPreview}}" data-src="{{avatarPreview}}" binderror="onAvatarImageError" mode="aspectFill" />
        <view wx:else class="avatar avatar-empty"><text>{{nicknameInitial}}</text></view>
        <view class="avatar-edit-icon" aria-hidden="true"><image src="/assets/icons/tabbar/profile.png" mode="aspectFit" /></view>
      </view>
      <text class="avatar-action">更换头像</text>
    </button>
    <view class="header-copy"><text class="header-title">{{nickname || '还没有设置昵称'}}</text><text class="header-subtitle">个人资料可以跳过，以后随时修改</text></view>
  </view>
  <view wx:if="{{avatarPrivacyError}}" class="avatar-privacy-message {{avatarPrivacyTone}}" aria-role="alert">
    <text>{{avatarPrivacyError}}</text>
    <view wx:if="{{avatarPrivacyMode !== 'native'}}" class="avatar-error-actions">
      <button bindtap="authorizeAvatarPrivacy" loading="{{authorizingAvatar}}" disabled="{{profileLoading || authorizingAvatar || saving}}">重试授权</button>
      <button bindtap="openPrivacyGuide">查看《隐私保护指引》</button>
    </view>
  </view>

  <view wx:if="{{authState === 'offline'}}" class="auth-strip offline touch-target" bindtap="retryLogin" hover-class="profile-control-hover" aria-role="button" aria-label="资料加载失败，点此重试">
    <view class="auth-dot"></view><view><text class="auth-title">暂时离线</text><text class="auth-detail">{{authDetail}}</text></view>
  </view>
  <view wx:elif="{{authState === 'connecting'}}" class="auth-strip connecting" aria-label="正在加载资料">
    <view class="auth-dot"></view><view><text class="auth-title">正在加载资料</text><text class="auth-detail">请稍候</text></view>
  </view>

  <text class="section-title">个人资料</text>
  <form class="profile-form surface" bindsubmit="saveProfile">
    <view class="field-row"><text class="field-label">昵称</text><input type="nickname" name="nickname" maxlength="20" value="{{nickname}}" bindinput="onNicknameInput" disabled="{{profileLoading || saving}}" placeholder="填写昵称" /></view>
    <view class="phone-row">
      <view class="phone-copy"><text class="field-label">手机号</text><text class="phone-value">{{profile.phoneBound ? profile.maskedPhone : '未绑定（可选）'}}</text></view>
      <button class="phone-button" open-type="getPhoneNumber" bindgetphonenumber="onGetPhoneNumber" loading="{{bindingPhone}}" disabled="{{profileLoading || bindingPhone || saving}}" hover-class="button-hover">{{profile.phoneBound ? '更换' : '绑定'}}</button>
    </view>
    <text wx:if="{{phoneError}}" class="phone-error" aria-role="alert">{{phoneError}}</text>
    <button class="primary-button profile-save" form-type="submit" loading="{{saving}}" disabled="{{profileLoading || saving || bindingPhone}}" hover-class="button-hover">保存资料</button>
  </form>

  <text class="section-title">健康提醒</text>
  <view class="surface setting-list">
    <label class="setting-row touch-target" for="calcium-reminder-switch"><view class="setting-copy"><text class="setting-title">补钙食物提醒</text><text class="setting-detail">默认关闭，只在你主动开启后显示</text></view><view class="setting-switch-target"><switch id="calcium-reminder-switch" checked="{{settings.calciumAnchorReminder}}" disabled="{{profileLoading || savingSettings}}" color="{{nativeControlColor}}" data-key="calciumAnchorReminder" bindchange="toggleHealthSetting" aria-label="补钙食物提醒，当前{{settings.calciumAnchorReminder ? '已开启' : '已关闭'}}" /></view></label>
    <label class="setting-row touch-target" for="vitamin-d-reminder-switch"><view class="setting-copy"><text class="setting-title">维生素 D 复诊提醒</text><text class="setting-detail">默认关闭，可随时修改或关闭</text></view><view class="setting-switch-target"><switch id="vitamin-d-reminder-switch" checked="{{settings.vitaminDReminder}}" disabled="{{profileLoading || savingSettings}}" color="{{nativeControlColor}}" data-key="vitaminDReminder" bindchange="toggleHealthSetting" aria-label="维生素 D 复诊提醒，当前{{settings.vitaminDReminder ? '已开启' : '已关闭'}}" /></view></label>
    <view class="setting-row reminder-navigation touch-target" bindtap="openWaterReminder" hover-class="profile-control-hover" aria-role="button" aria-label="管理喝水提醒，当前{{waterReminderSummary}}"><view class="setting-copy"><text class="setting-title">喝水提醒</text><text class="setting-detail">{{waterReminderSummary}}</text></view><text class="setting-action">管理</text></view>
  </view>

  <text class="section-title">同步状态</text>
  <view class="surface data-list">
    <view class="data-row"><text>最近更新</text><text>{{updatedText}}</text></view>
    <view class="data-row"><text>网络不佳时</text><text>保留本次修改，联网后重试</text></view>
  </view>

  <block wx:if="{{member.role === 'owner'}}">
    <text class="section-title">邀请成员</text>
    <view class="invite-card surface">
      <view class="invite-heading"><view><text class="invite-title">已占用 {{occupiedCount}} / {{maxMembers}} 个名额</text><text class="invite-copy">{{memberCount}} 位已加入成员，{{activeInvites.length}} 个待使用邀请；总容量 {{maxMembers}} 人，邀请码单次使用，创建 {{inviteTtlText}}后失效</text></view></view>
      <label class="invite-field" for="invite-label-input">
        <text class="invite-field-label">邀请备注（可选）</text>
        <input id="invite-label-input" class="invite-label" maxlength="20" value="{{inviteLabel}}" bindinput="inputInviteLabel" disabled="{{profileLoading}}" placeholder="例如：家人" aria-label="邀请备注（可选）" />
      </label>
      <button class="secondary-button" loading="{{creatingInvite}}" disabled="{{profileLoading || creatingInvite || revokingInviteRef || !inviteCapacityKnown || occupiedCount >= maxMembers}}" bindtap="createInvite">生成一次性邀请码</button>
      <view wx:if="{{inviteCode}}" class="invite-result touch-target" bindtap="copyInvite" hover-class="profile-control-hover" aria-role="button" aria-label="复制邀请码"><text class="invite-code">{{inviteCode}}</text><text class="invite-expire">有效至 {{inviteExpiresText}}（北京时间） · 点击复制</text></view>

      <view class="active-invite-heading"><text class="active-invite-title">待使用邀请</text><text class="active-invite-count">{{activeInvites.length}} 个</text></view>
      <view wx:if="{{membersState === 'loading' || membersState === 'idle'}}" class="active-invite-empty"><text>正在加载邀请状态</text></view>
      <view wx:elif="{{membersState === 'error'}}" class="active-invite-empty error"><text>邀请状态暂时不可用，请重试</text><button bindtap="retryMembers" disabled="{{profileLoading || revokingInviteRef || creatingInvite}}">重试</button></view>
      <view wx:elif="{{!activeInvites.length}}" class="active-invite-empty"><text>暂无待使用邀请</text><text class="active-invite-hint">新生成的邀请码会在这里显示状态，但不会再次显示明文。</text></view>
      <view wx:else class="active-invite-list">
        <view wx:for="{{activeInvites}}" wx:key="inviteRef" class="active-invite-row">
          <view class="active-invite-copy"><text class="active-invite-label">{{item.label}}</text><text class="active-invite-expire">有效至 {{item.expiresText}}（北京时间）</text></view>
          <button class="invite-revoke" data-invite-ref="{{item.inviteRef}}" bindtap="revokeInvite" hover-class="profile-control-hover" loading="{{revokingInviteRef === item.inviteRef}}" disabled="{{profileLoading || revokingInviteRef || creatingInvite}}" aria-label="撤销 {{item.label}} 的待使用邀请">撤销</button>
        </view>
      </view>
    </view>

    <text class="section-title">管理员交接</text>
    <view class="transfer-card surface">
      <text class="transfer-title">选择一名普通成员接任</text>
      <text class="transfer-copy">转移后你会立即变为普通成员。成员列表只显示称呼和随机成员编号。</text>

      <view wx:if="{{membersState === 'loading' || membersState === 'idle'}}" class="member-status">
        <view class="member-skeleton skeleton"></view>
        <view class="member-skeleton short skeleton"></view>
        <text class="member-status-copy">正在加载成员</text>
      </view>
      <view wx:elif="{{membersState === 'error'}}" class="member-status">
        <text class="member-status-title">成员列表暂时不可用</text>
        <text class="member-status-copy">{{membersError}}</text>
        <button class="member-retry" bindtap="retryMembers" disabled="{{profileLoading || transferringOwner}}">重试</button>
      </view>
      <view wx:elif="{{membersState === 'empty'}}" class="member-status">
        <text class="member-status-title">还没有可接任的成员</text>
        <text class="member-status-copy">成员使用一次性邀请码加入后，会显示在这里。</text>
      </view>
      <radio-group wx:else class="member-options" bindchange="selectTransferMember">
        <label wx:for="{{transferMembers}}" wx:key="memberRef" class="member-option touch-target {{selectedMemberRef === item.memberRef ? 'selected' : ''}}">
          <radio value="{{item.memberRef}}" checked="{{selectedMemberRef === item.memberRef}}" disabled="{{profileLoading || transferringOwner}}" color="{{nativeControlColor}}" />
          <view class="member-copy">
            <text class="member-name">{{item.displayName}}</text>
            <text class="member-ref">成员编号 {{item.memberRef}}</text>
          </view>
        </label>
      </radio-group>

      <button class="transfer-button" bindtap="transferOwner" loading="{{transferringOwner}}" disabled="{{profileLoading || transferringOwner || membersState !== 'ready' || !selectedMemberRef}}">转移管理员身份</button>
    </view>
  </block>

  <text class="section-title">隐私与数据</text>
  <view class="surface privacy-data-list" aria-label="隐私与数据设置">
    <view class="privacy-summary-row">
      <text class="privacy-summary-title">个人资料均为可选</text>
      <text class="privacy-summary-detail">头像、昵称和手机号不填写也可以正常使用餐单、采购与健康记录。</text>
    </view>
    <view class="legal-row touch-target" bindtap="openUserAgreement" hover-class="profile-control-hover" aria-role="button" aria-label="查看用户协议">
      <view class="legal-copy"><text class="legal-title">用户协议</text><text class="legal-detail">了解服务规则与使用范围</text></view>
      <text class="legal-action">查看</text>
    </view>
    <view class="legal-row touch-target" bindtap="openPrivacyGuide" hover-class="profile-control-hover" aria-role="button" aria-label="查看隐私保护指引">
      <view class="legal-copy"><text class="legal-title">隐私保护指引</text><text class="legal-detail">了解资料和私人数据如何处理</text></view>
      <text class="legal-action">查看</text>
    </view>
  </view>
  <text wx:if="{{legalPrivacyError}}" class="legal-privacy-error" aria-role="alert">{{legalPrivacyError}}</text>

  <text class="section-title danger-section-title">危险操作</text>
  <view class="surface danger-card">
    <text class="danger-title">清空私人数据</text>
    <text class="danger-detail">将删除你的资料、餐单、采购、提醒与健康记录，删除后不可恢复。</text>
    <button class="danger-button" bindtap="clearMyData" loading="{{clearingData}}" disabled="{{profileLoading || clearingData}}" hover-class="profile-control-hover">{{clearingData ? '正在清空' : '清空我的私人数据'}}</button>
  </view>
</view>
