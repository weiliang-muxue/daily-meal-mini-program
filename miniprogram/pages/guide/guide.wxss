.page-navigation { box-sizing: border-box; width: 48px; min-width: 48px; max-width: 48px; height: 48px; min-height: 48px; margin: 0 0 12rpx; padding: 0; display: flex; align-items: center; justify-content: center; border: 1rpx solid var(--line-strong); border-radius: 50%; background: var(--surface); color: var(--primary); }
.page-navigation::after { border: 0; }
.page-navigation-pressed { background: var(--pressed); opacity: .78; }
.page-navigation-icon { position: relative; width: 24px; height: 24px; color: inherit; }
.page-navigation-icon.back::before { content: ""; position: absolute; left: 5px; top: 6px; width: 10px; height: 10px; border-bottom: 2px solid currentColor; border-left: 2px solid currentColor; transform: rotate(45deg); }
.page-navigation-icon.back::after { content: ""; position: absolute; left: 6px; top: 11px; width: 14px; height: 2px; border-radius: 1px; background: currentColor; }
.page-navigation-icon.home::before { content: ""; position: absolute; left: 6px; top: 3px; width: 11px; height: 11px; border-top: 2px solid currentColor; border-left: 2px solid currentColor; transform: rotate(45deg); }
.page-navigation-icon.home::after { content: ""; position: absolute; left: 5px; bottom: 3px; width: 14px; height: 11px; border: 2px solid currentColor; border-top: 0; border-radius: 0 0 2px 2px; }
.guide-heading { padding: 10rpx 2rpx 2rpx; }
.guide-title { display: block; font-size: 24px; line-height: 1.3; font-weight: 760; }
.section-title { font-size: 18px; line-height: 1.3; font-weight: 720; }
.guide-copy { display: block; margin-top: 10rpx; color: var(--muted); font-size: 13px; line-height: 1.6; overflow-wrap: anywhere; }
.anchor-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 18rpx; }
.anchor { padding: 26rpx; }
.anchor-number { display: block; color: var(--gold); font-weight: 800; font-size: 12px; }
.anchor-title { display: block; font-size: 15px; font-weight: 720; margin: 14rpx 0 10rpx; }
.anchor-copy { display: block; color: var(--muted); font-size: 14px; line-height: 1.55; overflow-wrap: anywhere; }
.setting-list { overflow: hidden; }
.setting-row { min-height: 128rpx; padding: 24rpx 28rpx; display: flex; align-items: center; justify-content: space-between; gap: 20rpx; border-bottom: 1rpx solid var(--line); }
.setting-copy-wrap { min-width: 0; flex: 1; }
.setting-switch-target { width: 48px; min-width: 48px; min-height: 48px; display: flex; align-items: center; justify-content: flex-end; }
.setting-row:last-child { border-bottom: 0; }
.setting-title { display: block; font-weight: 700; }
.setting-copy { display: block; color: var(--muted); font-size: 14px; line-height: 1.5; margin-top: 6rpx; overflow-wrap: anywhere; }
.reminder-form { padding: 24rpx; }
.reminder-form textarea { width: 100%; min-height: 100rpx; padding: 18rpx 20rpx; border: 1rpx solid var(--line-strong); border-radius: 10rpx; background: var(--input-surface); color: var(--ink); line-height: 1.55; margin-bottom: 18rpx; }
.reminder-list { overflow: hidden; }
.reminder-row { min-height: 104rpx; padding: 18rpx 24rpx; display: flex; align-items: center; gap: 16rpx; border-bottom: 1rpx solid var(--line); }
.reminder-row:last-child { border-bottom: 0; }
.reminder-main { min-width: 0; min-height: 88rpx; flex: 1; display: flex; align-items: center; gap: 16rpx; line-height: 1.5; overflow-wrap: anywhere; }
.reminder-check { flex: none; width: 42rpx; height: 42rpx; border: 2rpx solid var(--line-strong); border-radius: 50%; display: flex; align-items: center; justify-content: center; color: var(--on-primary); }
.reminder-main.done .reminder-check { background: var(--primary-fill); border-color: var(--primary-fill); }
.reminder-main.done text { color: var(--checked-text); text-decoration: line-through; }
.reminder-main.disabled, .remove.disabled { opacity: .48; }
.remove { min-width: 88rpx; min-height: 88rpx; display: flex; align-items: center; justify-content: flex-end; color: var(--danger); font-size: 14px; }
.reminder-hover { background: var(--pressed); }
.remove-hover { opacity: .72; background: var(--danger-soft); }
.warning { margin-top: 30rpx; padding: 26rpx; border-left: 6rpx solid var(--warm); background: var(--warm-soft); color: var(--warm-ink); font-size: 14px; line-height: 1.65; overflow-wrap: anywhere; }
.warning-title { display: block; color: var(--warm-ink); font-weight: 750; margin-bottom: 8rpx; }
.vitamin-note { margin-top: 24rpx; padding: 26rpx; border-left: 6rpx solid var(--gold); }
.block-title { display: block; font-size: 15px; line-height: 1.4; font-weight: 730; }
.block-copy { display: block; margin-top: 8rpx; color: var(--muted); font-size: 14px; line-height: 1.6; overflow-wrap: anywhere; }
.guide-state { min-height: 360rpx; padding: 48rpx 30rpx; display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; }
.guide-state.error-state { border-color: var(--danger-line); }
.guide-retry { width: 100%; margin-top: 28rpx; }
.guide-title-skeleton { width: 58%; height: 44rpx; border-radius: 8rpx; }
.guide-line-skeleton { width: 82%; height: 28rpx; margin-top: 20rpx; border-radius: 7rpx; }
.guide-card-skeleton { width: 100%; height: 260rpx; margin-top: 30rpx; border-radius: 12rpx; }
.sync-strip { min-height: 96rpx; margin-bottom: 20rpx; padding: 18rpx 20rpx; display: flex; align-items: center; gap: 18rpx; border: 1rpx solid var(--line-strong); border-radius: 10rpx; }
.sync-strip.saving { background: var(--surface-muted); color: var(--muted-strong); }
.sync-strip.offline { border-color: var(--warm-line); background: var(--warm-soft); color: var(--warm-ink); }
.sync-message { min-width: 0; flex: 1; }
.sync-title { display: block; font-size: 14px; line-height: 1.4; font-weight: 750; }
.sync-copy { display: block; margin-top: 4rpx; font-size: 12px; line-height: 1.45; overflow-wrap: anywhere; }
.sync-retry { min-width: 156rpx; min-height: 88rpx; margin: -12rpx -10rpx -12rpx 0; padding: 0 16rpx; display: flex; align-items: center; justify-content: center; background: transparent; color: inherit; font-size: 14px; font-weight: 750; }
@media (max-width: 340px) {
  .anchor-grid { grid-template-columns: minmax(0, 1fr); }
  .setting-row { align-items: flex-start; }
  .sync-strip { align-items: flex-start; flex-wrap: wrap; }
  .sync-retry { width: 100%; margin: 0; justify-content: flex-start; }
}
@media (max-width: 400px) {
  .reminder-main, .remove { min-height: 48px; }
}
