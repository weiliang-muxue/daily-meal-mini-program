<view class="screen">
  <button class="page-navigation" bindtap="navigateFromPage" hover-class="page-navigation-pressed" aria-label="{{pageNavigationLabel}}">
    <view class="page-navigation-icon {{canNavigateBack ? 'back' : 'home'}}" aria-hidden="true"></view>
  </button>
  <view wx:if="{{loading}}" class="guide-state surface" aria-label="正在加载健康提醒">
    <view class="skeleton guide-title-skeleton"></view>
    <view class="skeleton guide-line-skeleton"></view>
    <view class="skeleton guide-card-skeleton"></view>
    <text class="status-detail">正在读取已保存的提醒与设置</text>
  </view>

  <view wx:elif="{{error}}" class="guide-state error-state surface" aria-role="alert">
    <text class="status-title">健康提醒暂时无法加载</text>
    <text class="status-detail">{{error}}</text>
    <button class="secondary-button guide-retry" bindtap="retryConnect" hover-class="button-hover">重新加载</button>
  </view>

  <block wx:else>
  <view wx:if="{{saving}}" class="sync-strip saving" aria-live="polite">
    <text class="sync-title">正在同步</text>
    <text class="sync-copy">本次修改已保存，正在同步</text>
  </view>
  <view wx:elif="{{offline}}" class="sync-strip offline" aria-role="alert">
    <view class="sync-message">
      <text class="sync-title">修改已保存，尚未同步</text>
      <text class="sync-copy">{{saveError}}</text>
    </view>
    <button class="sync-retry" bindtap="retrySync" disabled="{{saving}}" hover-class="button-hover">重试同步</button>
  </view>

  <view class="guide-heading">
    <text class="guide-title">按需开启健康提醒</text>
    <text class="guide-copy">这里显示你当前的提醒状态，可以随时按自己的需要开启或关闭。</text>
  </view>

  <text class="section-title">计划提醒</text>
  <view class="surface setting-list">
    <label class="setting-row touch-target" for="guide-calcium-reminder-switch"><view class="setting-copy-wrap"><text class="setting-title">补钙食物提醒</text><text class="setting-copy">开启后显示普通食物搭配提示</text></view><view class="setting-switch-target"><switch id="guide-calcium-reminder-switch" checked="{{settings.calciumAnchorReminder}}" disabled="{{saving}}" color="{{nativeControlColor}}" data-key="calciumAnchorReminder" bindchange="toggleSetting" aria-label="补钙食物提醒，当前{{settings.calciumAnchorReminder ? '已开启' : '已关闭'}}" /></view></label>
    <label class="setting-row touch-target" for="guide-vitamin-d-reminder-switch"><view class="setting-copy-wrap"><text class="setting-title">维生素 D 复诊提醒</text><text class="setting-copy">开启后显示复诊核对提示</text></view><view class="setting-switch-target"><switch id="guide-vitamin-d-reminder-switch" checked="{{settings.vitaminDReminder}}" disabled="{{saving}}" color="{{nativeControlColor}}" data-key="vitaminDReminder" bindchange="toggleSetting" aria-label="维生素 D 复诊提醒，当前{{settings.vitaminDReminder ? '已开启' : '已关闭'}}" /></view></label>
  </view>

  <block wx:if="{{settings.calciumAnchorReminder}}">
    <text class="section-title">补钙食物提醒</text>
    <view class="anchor-grid">
    <view class="anchor surface"><text class="anchor-number">01</text><text class="anchor-title">奶或强化豆奶</text><text class="anchor-copy">约 300 ml，豆奶看标签确认强化钙含量。</text></view>
    <view class="anchor surface"><text class="anchor-number">02</text><text class="anchor-title">酸奶 / 豆腐 / 小鱼</text><text class="anchor-copy">再选一个食物来源，深绿叶菜是加分项。</text></view>
    </view>
  </block>

  <view wx:if="{{settings.vitaminDReminder}}" class="vitamin-note surface">
    <text class="block-title">维生素 D 复诊提醒</text>
    <text class="block-copy">补充剂剂量、检测和疗程应由医生结合你的情况决定，不根据小程序内容自行调整。</text>
  </view>

  <text class="section-title">我的补充提醒</text>
  <view class="reminder-form surface">
    <textarea maxlength="80" value="{{newReminder}}" disabled="{{saving}}" bindinput="inputReminder" placeholder="例如：复诊时带钙片瓶身" auto-height />
    <button class="primary-button" bindtap="addReminder" loading="{{saving}}" disabled="{{saving}}" hover-class="button-hover">添加提醒</button>
  </view>
  <view wx:if="{{!reminders.length}}" class="surface status-panel"><text class="status-title">还没有个人提醒</text><text class="status-detail">这里适合记录复诊问题、补充剂标签或计划调整。</text></view>
  <view wx:else class="surface reminder-list">
    <view wx:for="{{reminders}}" wx:key="id" class="reminder-row">
      <view class="reminder-main touch-target {{item.done ? 'done' : ''}} {{saving ? 'disabled' : ''}}" data-id="{{item.id}}" bindtap="toggleReminder" hover-class="reminder-hover" aria-role="checkbox" aria-checked="{{item.done}}" aria-disabled="{{saving}}"><view class="reminder-check">{{item.done ? '✓' : ''}}</view><text>{{item.text}}</text></view>
      <view class="remove touch-target {{saving ? 'disabled' : ''}}" data-id="{{item.id}}" bindtap="removeReminder" hover-class="remove-hover" aria-role="button" aria-disabled="{{saving}}" aria-label="删除提醒">删除</view>
    </view>
  </view>

  <view wx:if="{{settings.calciumAnchorReminder || settings.vitaminDReminder}}" class="warning"><text class="warning-title">提醒边界</text><text>这些内容只帮助记录和日常执行，不构成诊断、处方或治疗建议。持续不适或治疗相关问题请联系医生，不要自行叠加补充剂或调整用药。</text></view>
  </block>
</view>
