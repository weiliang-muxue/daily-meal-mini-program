.month-nav { min-height: 100rpx; display: grid; grid-template-columns: 88rpx 1fr 88rpx; align-items: center; text-align: center; }
.month-button { width: 88rpx; height: 88rpx; display: flex; align-items: center; justify-content: center; border-radius: 50%; background: var(--surface); border: 1rpx solid var(--line); color: var(--primary); }
.month-chevron { width: 14rpx; height: 14rpx; flex: none; border-right: 2rpx solid currentColor; border-bottom: 2rpx solid currentColor; }
.month-chevron-left { transform: rotate(135deg); }
.month-chevron-right { transform: rotate(-45deg); }
.month-title { display: block; font-size: 19px; font-weight: 760; }
.month-subtitle { display: block; margin-top: 5rpx; color: var(--muted); font-size: 12px; }
.offline-strip { min-height: 88rpx; padding: 18rpx; margin: 14rpx 0; display: flex; align-items: center; border: 1rpx solid var(--warm-line); border-radius: 10rpx; background: var(--warm-soft); color: var(--warm-ink); font-size: 14px; line-height: 1.5; overflow-wrap: anywhere; }
.calendar { margin-top: 12rpx; padding: 16rpx 14rpx 12rpx; overflow: hidden; }
.calendar-scroll, .calendar-content { width: 100%; min-width: 0; }
.week-row, .calendar-grid { width: 100%; min-width: 0; display: grid; grid-template-columns: repeat(7, minmax(0, 1fr)); }
.week-row text { height: 28px; display: flex; align-items: center; justify-content: center; color: var(--muted); font-size: 12px; }
.day-cell { position: relative; width: 100%; min-width: 0; min-height: 120rpx; padding: 8rpx 4rpx 27rpx; border-radius: 10rpx; display: flex; flex-direction: column; align-items: center; border: 2rpx solid transparent; }
.day-cell.empty { pointer-events: none; }
.day-cell.exercised { background: var(--exercise-calendar-surface); border-top-color: var(--exercise-calendar-border); border-top-width: 4rpx; box-shadow: inset 0 0 0 2px var(--exercise-calendar-border); }
.day-cell.exercised .day-number { color: var(--exercise-calendar-ink); font-weight: 800; }
.day-cell.today .day-number { color: var(--primary); font-weight: 800; }
.day-cell.selected { border-color: var(--primary); box-shadow: 0 0 0 1px var(--primary); }
.day-cell.exercised.selected { box-shadow: inset 0 0 0 1px var(--exercise-calendar-border), 0 0 0 1px var(--primary); }
.day-cell.day-hover { opacity: .74; background: var(--pressed); }
.day-number { font-size: 14px; line-height: 1.1; }
.weight-number { max-width: 100%; margin-top: 5px; color: var(--muted-strong); font-size: 12px; line-height: 1.15; font-weight: 700; text-align: center; overflow-wrap: anywhere; }
.exercise-mark { position: absolute; bottom: 3px; left: 1px; right: 1px; min-width: 0; min-height: 20rpx; padding: 2rpx 4rpx; display: flex; flex-wrap: wrap; align-items: center; justify-content: center; gap: 2px 4px; border-radius: var(--radius-pill); background: var(--exercise-saved-chip); color: var(--exercise-calendar-ink); font-size: 12px; line-height: 1.15; font-weight: 800; }
.exercise-dot { width: 14rpx; height: 14rpx; flex: none; border-radius: 50%; background: var(--success); box-shadow: 0 0 0 3rpx var(--exercise-saved-chip); }
.photo-mark { position: absolute; top: 7rpx; right: 7rpx; width: 10rpx; height: 10rpx; border: 2rpx solid var(--gold); border-radius: 2rpx; }
.legend { display: flex; flex-wrap: wrap; justify-content: center; gap: 8px 16px; margin-top: 16rpx; color: var(--muted); font-size: 12px; }
.legend view { display: flex; align-items: center; gap: 8rpx; }
.legend-dot { width: 13rpx; height: 13rpx; border-radius: 50%; background: var(--success); }.legend-photo { width: 13rpx; height: 13rpx; border: 2rpx solid var(--gold); border-radius: 2rpx; }
.record-card, .trend-card { margin-top: 24rpx; padding: 28rpx; }
.record-heading, .trend-heading, .exercise-row { display: flex; align-items: center; justify-content: space-between; gap: 20rpx; }
.record-date, .trend-title { display: block; font-size: 17px; font-weight: 740; }
.record-caption, .trend-copy, .field-hint { display: block; color: var(--muted); font-size: 12px; line-height: 1.5; margin-top: 6rpx; overflow-wrap: anywhere; }
.saved-badge { padding: 9rpx 14rpx; border-radius: 8rpx; background: var(--primary-soft); color: var(--primary); font-size: 12px; font-weight: 700; }
.weight-row { display: grid; grid-template-columns: 1fr 150rpx; gap: 20rpx; margin: 24rpx 0 30rpx; }
.field-label { display: block; font-weight: 700; margin-bottom: 10rpx; }
.weight-input, .duration-field { min-height: 88rpx; padding: 0 18rpx; border: 1rpx solid var(--line-strong); border-radius: 10rpx; display: flex; align-items: center; gap: 10rpx; background: var(--input-surface); color: var(--ink); }
.weight-input input, .duration-field input { flex: 1; min-width: 0; font-size: 16px; }
.photo-button { height: 128rpx; border-radius: 10rpx; overflow: hidden; border: 1rpx dashed var(--line-strong); display: flex; align-items: center; justify-content: center; color: var(--primary); font-size: 14px; }
.photo-button.disabled { opacity: .48; }
.photo-button image { width: 100%; height: 100%; }
.photo-wrap { position: relative; }.remove-photo { min-height: 88rpx; display: flex; align-items: center; justify-content: center; color: var(--danger); font-size: 12px; }
.photo-privacy-error { margin: -12rpx 0 24rpx; padding: 20rpx; border: 1rpx solid var(--danger-line); border-radius: 8rpx; background: var(--danger-soft); color: var(--danger); font-size: 14px; line-height: 1.55; overflow-wrap: anywhere; }
.photo-error-actions { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12rpx; margin-top: 16rpx; }
.photo-error-button { min-height: 88rpx; margin: 0; padding: 12rpx; border: 1rpx solid var(--danger-line); border-radius: 8rpx; background: var(--surface); color: var(--primary); font-size: 14px; line-height: 1.4; }
.photo-error-button[disabled] { opacity: .48; }
.exercise-card { margin: 16rpx 0 0; padding: 20rpx 16rpx 18rpx; border: 2rpx solid var(--line-strong); border-left-width: 8rpx; border-radius: var(--radius-control); background: var(--surface-muted); box-shadow: var(--shadow-card); transition: background-color .2s ease, border-color .2s ease, box-shadow .2s ease; }
.exercise-card.pending { border-color: var(--gold-line); background: var(--gold-soft); box-shadow: var(--shadow-card); }
.exercise-card.saved { border-color: var(--exercise-saved-border); background: var(--exercise-saved-surface); box-shadow: var(--shadow-card); }
.exercise-card.cancel { border-color: var(--warm-line); background: var(--warm-soft); box-shadow: var(--shadow-card); }
.exercise-row { min-height: 60px; display: grid; grid-template-columns: 56px minmax(0, 1fr) auto; align-items: center; gap: 12px; }
.exercise-row:active { opacity: .78; }
.activity-ring { width: 56px; height: 56px; padding: 5px; border: 6px solid var(--exercise-idle-ring); border-radius: 50%; display: flex; align-items: center; justify-content: center; background: var(--surface); }
.activity-ring.saved { border-color: var(--exercise-saved-ring); box-shadow: 0 0 0 3px rgba(21, 148, 71, .14); }
.activity-ring.pending { border-color: var(--exercise-pending-ring); border-style: dashed; }
.activity-ring.cancel { border-color: var(--exercise-cancel-ring); border-style: dashed; }
.activity-ring-core { width: 100%; height: 100%; border-radius: 50%; display: flex; align-items: center; justify-content: center; background: var(--surface-muted); color: var(--muted-strong); font-size: 16px; line-height: 1; font-weight: 800; }
.activity-ring.saved .activity-ring-core { background: var(--exercise-saved-core); color: var(--exercise-saved-ink); }
.activity-ring.pending .activity-ring-core { background: var(--gold-soft); color: var(--gold-ink); font-size: 12px; }
.activity-ring.cancel .activity-ring-core { background: var(--warm-soft); color: var(--warm-ink); font-size: 12px; }
.exercise-heading-copy { min-width: 0; flex: 1; }
.exercise-title-line { display: flex; align-items: center; flex-wrap: wrap; gap: 10rpx; }
.exercise-title-line .field-label { margin-bottom: 0; font-size: 18px; line-height: 1.3; font-weight: 760; }
.exercise-state { padding: 5rpx 10rpx; border: 1rpx solid var(--line-strong); border-radius: 6rpx; background: var(--surface-muted); color: var(--muted-strong); font-size: 12px; line-height: 1.25; font-weight: 750; }
.exercise-state.pending { background: var(--gold-soft); color: var(--gold-ink); }
.exercise-state.saved { background: var(--exercise-saved-chip); color: var(--exercise-saved-ink); border-color: var(--exercise-saved-border); }
.exercise-state.cancel { background: var(--warm-soft); color: var(--warm-ink); }
.exercise-switch-target { width: 58px; min-height: 48px; padding: 2px; display: flex; align-items: center; justify-content: center; border: 2rpx solid var(--line-strong); border-radius: var(--radius-pill); background: var(--surface); box-shadow: var(--shadow-control); }
.exercise-card.pending .exercise-switch-target { border-color: var(--gold-line); background: var(--gold-soft); }
.exercise-card.saved .exercise-switch-target { border-color: var(--exercise-saved-border); background: var(--exercise-saved-chip); }
.exercise-card.cancel .exercise-switch-target { border-color: var(--warm-line); background: var(--warm-soft); }
.exercise-fields { padding-top: 22rpx; display: grid; grid-template-columns: 1fr 180rpx; gap: 14rpx; border-top: 1rpx solid var(--line); }
.exercise-card.pending .exercise-fields { border-top-color: var(--gold-line); }
.exercise-card.saved .exercise-fields { border-top-color: var(--exercise-saved-border); }
.exercise-field { min-width: 0; }
.picker-field { min-height: 88rpx; padding: 0 18rpx; border: 1rpx solid var(--line-strong); border-radius: 10rpx; display: flex; align-items: center; background: var(--input-surface); color: var(--ink); }
.intensity-field { grid-column: 1 / -1; min-width: 0; }
.intensity { display: grid; grid-template-columns: repeat(3,1fr); gap: 8rpx; padding: 8rpx; border-radius: 10rpx; background: var(--surface-muted); }
.intensity view { min-height: 88rpx; display: flex; align-items: center; justify-content: center; border: 2rpx solid transparent; border-radius: 8rpx; color: var(--muted); font-size: 14px; }.intensity view.active { border-color: var(--line); background: var(--surface); color: var(--primary); font-weight: 700; box-shadow: 0 2rpx 8rpx var(--shadow-soft); }
.intensity-check { width: 18px; margin-right: 2px; opacity: 0; font-weight: 800; text-align: center; }
.intensity-check.visible { opacity: 1; }
.note { width: 100%; min-height: 86rpx; margin: 24rpx 0; padding: 20rpx; border: 1rpx solid var(--line-strong); border-radius: 10rpx; background: var(--input-surface); color: var(--ink); line-height: 1.55; }
.field-invalid { border-color: var(--danger); box-shadow: 0 0 0 1px var(--danger); }
.field-error, .form-error { display: block; margin-top: 8rpx; color: var(--danger); font-size: 12px; line-height: 1.45; overflow-wrap: anywhere; }
.form-error { margin: -12rpx 0 20rpx; }
.trend-heading { align-items: flex-start; }
.trend-notice { min-height: 88rpx; margin-top: 16rpx; padding: 14rpx 16rpx; display: flex; align-items: center; border: 1rpx solid var(--warm-line); border-radius: 8rpx; background: var(--warm-soft); color: var(--warm-ink); font-size: 14px; line-height: 1.5; overflow-wrap: anywhere; }
.trend-switch { display: grid; grid-template-columns: 1fr 1fr; padding: 6rpx; gap: 6rpx; background: var(--surface-muted); border-radius: 9rpx; flex: none; }
.trend-switch view { min-height: 88rpx; padding: 0 14rpx; display: flex; align-items: center; justify-content: center; color: var(--muted); font-size: 12px; border-radius: 7rpx; }.trend-switch view.active { background: var(--surface); color: var(--primary); font-weight: 700; }
.metric-switch { display: grid; grid-template-columns: 1fr 1fr; gap: 6rpx; margin-top: 22rpx; padding: 6rpx; border-radius: 9rpx; background: var(--surface-muted); }
.metric-switch view { min-height: 88rpx; display: flex; align-items: center; justify-content: center; border: 2rpx solid transparent; border-radius: 7rpx; color: var(--muted); font-size: 14px; font-weight: 650; }.metric-switch view.active { border-color: var(--line); background: var(--surface); color: var(--primary); box-shadow: 0 2rpx 8rpx var(--shadow-soft); }
.weight-chart { display: block; width: 100%; height: 280rpx; margin-top: 26rpx; border: 1rpx solid var(--line); border-radius: 8rpx; background: var(--chart-surface); }
.exercise-summary { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 8px; padding-top: 22rpx; border-top: 1rpx solid var(--line); }
.summary-period { min-width: 0; text-align: center; }
.summary-period-title { display: block; margin-bottom: 10px; color: var(--muted-strong); font-size: 13px; line-height: 1.3; font-weight: 700; }
.summary-rings { display: flex; align-items: center; justify-content: center; gap: 8px; }
.metric-ring { width: 56px; height: 56px; min-width: 0; border: 5px solid var(--exercise-summary-idle-ring); border-radius: 50%; display: flex; flex-direction: column; align-items: center; justify-content: center; background: var(--surface); }
.metric-ring.active { border-color: var(--exercise-summary-count-ring); }
.metric-ring.minutes.active { border-color: var(--exercise-summary-minutes-ring); }
.summary-value { display: block; max-width: 44px; color: var(--ink); font-size: 16px; line-height: 1; font-weight: 780; overflow: hidden; text-overflow: ellipsis; }
.ring-unit { display: block; margin-top: 3px; color: var(--muted); font-size: 12px; line-height: 1; }
.control-hover { opacity: .76; background: var(--pressed); }
.page-state { min-height: 360rpx; margin-top: 18rpx; padding: 48rpx 30rpx; display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; }
.error-state { border-color: var(--danger-line); }
.state-title { display: block; font-size: 16px; line-height: 1.4; font-weight: 750; }
.state-detail { display: block; max-width: 600rpx; margin-top: 16rpx; color: var(--muted); font-size: 14px; line-height: 1.6; overflow-wrap: anywhere; }
.state-action { width: 100%; margin-top: 28rpx; }
.state-title-skeleton { width: 52%; height: 42rpx; border-radius: 8rpx; }
.calendar-skeleton { width: 100%; height: 340rpx; margin-top: 28rpx; border-radius: 12rpx; }
@media (max-width: 340px) {
  .record-heading, .trend-heading { align-items: flex-start; flex-wrap: wrap; }
  .weight-row, .exercise-fields { grid-template-columns: minmax(0, 1fr); }
  .exercise-row { grid-template-columns: 48px minmax(0, 1fr) 48px; gap: 8px; }
  .activity-ring { width: 48px; height: 48px; padding: 4px; border-width: 5px; }
  .summary-rings { gap: 5px; }
  .metric-ring { width: 53px; height: 53px; }
  .photo-error-actions { grid-template-columns: minmax(0, 1fr); }
}
@media (max-width: 400px) {
  .health-screen {
    padding-left: calc(12px + constant(safe-area-inset-left));
    padding-right: calc(12px + constant(safe-area-inset-right));
    padding-left: calc(12px + env(safe-area-inset-left));
    padding-right: calc(12px + env(safe-area-inset-right));
  }
  .month-nav { grid-template-columns: 48px minmax(0, 1fr) 48px; }
  .month-button { width: 48px; height: 48px; }
  .calendar {
    margin-left: -12px;
    margin-right: -12px;
    margin-top: 8px;
    padding-top: 6px;
    padding-right: 0;
    padding-bottom: 4px;
    padding-left: 0;
    border-left: 0;
    border-right: 0;
    border-radius: 0;
  }
  .calendar-scroll { width: 100%; max-width: 100%; min-width: 0; overflow: visible; }
  .calendar-content { width: 100%; min-width: 0; overflow: visible; }
  .week-row text { height: 22px; }
  .calendar .day-cell {
    min-width: 0;
    min-height: 48px;
    padding-top: 4px;
    padding-right: 1px;
    padding-bottom: 18px;
    padding-left: 1px;
  }
  .record-card { margin-top: 10px; padding-top: 16px; padding-bottom: 18px; }
  .exercise-card { margin-top: 12px; padding-top: 16px; padding-right: 12px; padding-bottom: 16px; padding-left: 12px; }
  .legend { margin-top: 6px; gap: 6px 14px; }
  .month-subtitle, .record-caption, .trend-copy, .field-hint, .saved-badge,
  .offline-strip, .photo-privacy-error, .field-error, .form-error, .state-detail,
  .week-row text, .weight-number, .legend, .ring-unit, .photo-button, .remove-photo,
  .picker-field, .duration-field, .intensity view, .trend-switch view,
  .metric-switch view, .photo-error-button { font-size: 12px; }
  .day-number { font-size: 14px; }
  .exercise-mark { gap: 3px; font-size: 11px; }
  .exercise-dot { width: 6px; height: 6px; }
  .month-button { min-width: 48px; min-height: 48px; }
  .offline-strip, .trend-notice, .photo-button, .remove-photo, .picker-field,
  .intensity view, .trend-switch view, .metric-switch view, .photo-error-button {
    min-height: 48px;
  }
  .exercise-mark { font-size: 12px; }
  .record-caption, .trend-copy, .saved-badge, .trend-notice,
  .trend-switch view, .photo-button, .remove-photo, .photo-error-button { font-size: 13px; }
}

@media (max-width: 340px) {
  /* Keep a little extra vertical room for wrapped weight values in 320px cells. */
  .calendar .day-cell { min-height: 52px; padding-bottom: 20px; }
  .record-card { padding-top: 16px; padding-bottom: 18px; }
  .exercise-card { padding-right: 10px; padding-left: 10px; }
  .exercise-switch-target { width: 48px; }
}
