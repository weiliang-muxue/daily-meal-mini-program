.month-nav { min-height: 100rpx; display: grid; grid-template-columns: 88rpx 1fr 88rpx; align-items: center; text-align: center; }
.month-button { width: 88rpx; height: 88rpx; display: flex; align-items: center; justify-content: center; border-radius: 50%; background: var(--surface); border: 1rpx solid var(--line); font-size: 50rpx; color: var(--primary); }
.month-title { display: block; font-size: 38rpx; font-weight: 760; }
.month-subtitle { display: block; margin-top: 5rpx; color: var(--muted); font-size: 23rpx; }
.offline-strip { min-height: 88rpx; padding: 18rpx; margin: 14rpx 0; display: flex; align-items: center; border: 1rpx solid var(--warm-line); border-radius: 10rpx; background: var(--warm-soft); color: var(--warm-ink); font-size: 24rpx; line-height: 1.5; overflow-wrap: anywhere; }
.calendar { margin-top: 18rpx; padding: 20rpx 14rpx 16rpx; overflow: hidden; }
.week-row, .calendar-grid { display: grid; grid-template-columns: repeat(7, minmax(88rpx, 1fr)); }
.week-row text { height: 54rpx; display: flex; align-items: center; justify-content: center; color: var(--muted); font-size: 22rpx; }
.day-cell { position: relative; min-width: 88rpx; min-height: 104rpx; padding: 8rpx 4rpx; border-radius: 10rpx; display: flex; flex-direction: column; align-items: center; border: 2rpx solid transparent; }
.day-cell.empty { pointer-events: none; }
.day-cell.exercised { background: var(--primary-soft); }
.day-cell.today .day-number { color: var(--primary); font-weight: 800; }
.day-cell.selected { border-color: var(--primary); }
.day-cell.day-hover { opacity: .74; background: var(--pressed); }
.day-number { font-size: 25rpx; line-height: 1.1; }
.weight-number { max-width: 100%; margin-top: 9rpx; color: var(--muted-strong); font-size: 19rpx; line-height: 1.2; font-weight: 700; text-align: center; white-space: nowrap; }
.exercise-dot { position: absolute; bottom: 8rpx; width: 12rpx; height: 12rpx; border-radius: 50%; background: var(--success); }
.photo-mark { position: absolute; top: 7rpx; right: 7rpx; width: 10rpx; height: 10rpx; border: 2rpx solid var(--gold); border-radius: 2rpx; }
.legend { display: flex; flex-wrap: wrap; justify-content: center; gap: 14rpx 30rpx; margin-top: 16rpx; color: var(--muted); font-size: 21rpx; }
.legend view { display: flex; align-items: center; gap: 8rpx; }
.legend-dot { width: 13rpx; height: 13rpx; border-radius: 50%; background: var(--success); }.legend-photo { width: 13rpx; height: 13rpx; border: 2rpx solid var(--gold); border-radius: 2rpx; }
.record-card, .trend-card { margin-top: 24rpx; padding: 28rpx; }
.record-heading, .trend-heading, .exercise-row { display: flex; align-items: center; justify-content: space-between; gap: 20rpx; }
.record-date, .trend-title { display: block; font-size: 34rpx; font-weight: 740; }
.record-caption, .trend-copy, .field-hint { display: block; color: var(--muted); font-size: 22rpx; line-height: 1.5; margin-top: 6rpx; overflow-wrap: anywhere; }
.saved-badge { padding: 9rpx 14rpx; border-radius: 8rpx; background: var(--primary-soft); color: var(--primary); font-size: 22rpx; font-weight: 700; }
.weight-row { display: grid; grid-template-columns: 1fr 150rpx; gap: 20rpx; margin: 30rpx 0; }
.field-label { display: block; font-weight: 700; margin-bottom: 10rpx; }
.weight-input, .duration-field { min-height: 88rpx; padding: 0 18rpx; border: 1rpx solid var(--line-strong); border-radius: 10rpx; display: flex; align-items: center; gap: 10rpx; background: var(--input-surface); color: var(--ink); }
.weight-input input, .duration-field input { flex: 1; min-width: 0; font-size: 32rpx; }
.photo-button { height: 128rpx; border-radius: 10rpx; overflow: hidden; border: 1rpx dashed var(--line-strong); display: flex; align-items: center; justify-content: center; color: var(--primary); font-size: 23rpx; }
.photo-button image { width: 100%; height: 100%; }
.photo-wrap { position: relative; }.remove-photo { min-height: 88rpx; display: flex; align-items: center; justify-content: center; color: var(--danger); font-size: 22rpx; }
.exercise-row { min-height: 100rpx; border-top: 1rpx solid var(--line); border-bottom: 1rpx solid var(--line); }
.exercise-fields { padding: 22rpx 0; display: grid; grid-template-columns: 1fr 180rpx; gap: 14rpx; }
.picker-field { min-height: 88rpx; padding: 0 18rpx; border: 1rpx solid var(--line-strong); border-radius: 10rpx; display: flex; align-items: center; background: var(--input-surface); color: var(--ink); }
.intensity { grid-column: 1 / -1; display: grid; grid-template-columns: repeat(3,1fr); gap: 8rpx; padding: 8rpx; border-radius: 10rpx; background: var(--surface-muted); }
.intensity view { min-height: 88rpx; display: flex; align-items: center; justify-content: center; border-radius: 8rpx; color: var(--muted); font-size: 25rpx; }.intensity view.active { background: var(--primary-fill); color: var(--on-primary); }
.note { width: 100%; min-height: 86rpx; margin: 24rpx 0; padding: 20rpx; border: 1rpx solid var(--line-strong); border-radius: 10rpx; background: var(--input-surface); color: var(--ink); line-height: 1.55; }
.trend-heading { align-items: flex-start; }
.trend-switch { display: grid; grid-template-columns: 1fr 1fr; padding: 6rpx; gap: 6rpx; background: var(--surface-muted); border-radius: 9rpx; flex: none; }
.trend-switch view { min-height: 88rpx; padding: 0 14rpx; display: flex; align-items: center; justify-content: center; color: var(--muted); font-size: 22rpx; border-radius: 7rpx; }.trend-switch view.active { background: var(--surface); color: var(--primary); font-weight: 700; }
.metric-switch { display: grid; grid-template-columns: 1fr 1fr; gap: 10rpx; margin-top: 22rpx; }
.metric-switch view { min-height: 88rpx; display: flex; align-items: center; justify-content: center; border: 1rpx solid var(--line-strong); border-radius: 9rpx; color: var(--muted); font-size: 24rpx; font-weight: 650; }.metric-switch view.active { background: var(--primary-fill); color: var(--on-primary); border-color: var(--primary-fill); }
.weight-chart { display: block; width: 100%; height: 280rpx; margin-top: 26rpx; border: 1rpx solid var(--line); border-radius: 8rpx; background: var(--chart-surface); }
.exercise-summary { display: grid; grid-template-columns: repeat(4, 1fr); gap: 8rpx; padding-top: 22rpx; border-top: 1rpx solid var(--line); }
.exercise-summary view { min-width: 0; text-align: center; }.summary-value { display: block; color: var(--primary); font-size: 31rpx; font-weight: 760; }.summary-label { display: block; margin-top: 5rpx; color: var(--muted); font-size: 19rpx; line-height: 1.35; overflow-wrap: anywhere; }
.control-hover { opacity: .76; background: var(--pressed); }
.page-state { min-height: 560rpx; margin-top: 18rpx; padding: 56rpx 30rpx; display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; }
.error-state { border-color: var(--danger-line); }
.state-title { display: block; font-size: 32rpx; line-height: 1.4; font-weight: 750; }
.state-detail { display: block; max-width: 600rpx; margin-top: 16rpx; color: var(--muted); font-size: 25rpx; line-height: 1.6; overflow-wrap: anywhere; }
.state-action { width: 100%; margin-top: 28rpx; }
.state-title-skeleton { width: 52%; height: 42rpx; border-radius: 8rpx; }
.calendar-skeleton { width: 100%; height: 340rpx; margin-top: 28rpx; border-radius: 12rpx; }
@media (max-width: 340px) {
  .record-heading, .trend-heading { align-items: flex-start; flex-wrap: wrap; }
  .weight-row, .exercise-fields { grid-template-columns: minmax(0, 1fr); }
  .exercise-summary { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 18rpx 8rpx; }
}
@media (max-width: 400px) {
  .health-screen { padding-left: 4px; padding-right: 4px; }
  .calendar { padding-left: 0; padding-right: 0; }
  .week-row, .calendar-grid { grid-template-columns: repeat(7, minmax(44px, 1fr)); }
  .day-cell { min-width: 44px; min-height: 48px; }
  .month-button { min-width: 48px; min-height: 48px; }
  .offline-strip, .photo-button, .remove-photo, .picker-field,
  .intensity view, .trend-switch view, .metric-switch view {
    min-height: 48px;
  }
}
