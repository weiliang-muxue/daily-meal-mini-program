.month-nav { min-height: 100rpx; display: grid; grid-template-columns: 88rpx 1fr 88rpx; align-items: center; text-align: center; }
.month-button { width: 80rpx; height: 80rpx; display: flex; align-items: center; justify-content: center; border-radius: 50%; background: #fff; border: 1rpx solid #dce4de; font-size: 50rpx; color: #176b46; }
.month-title { display: block; font-size: 38rpx; font-weight: 760; }
.month-subtitle { display: block; margin-top: 5rpx; color: #68766f; font-size: 23rpx; }
.offline-strip { padding: 18rpx; margin: 14rpx 0; border-radius: 10rpx; background: #fff0e9; color: #8a4736; font-size: 24rpx; }
.calendar { margin-top: 18rpx; padding: 20rpx 14rpx 16rpx; overflow: hidden; }
.week-row, .calendar-grid { display: grid; grid-template-columns: repeat(7, 1fr); }
.week-row text { height: 54rpx; display: flex; align-items: center; justify-content: center; color: #68766f; font-size: 22rpx; }
.day-cell { position: relative; height: 104rpx; margin: 3rpx; padding: 8rpx 4rpx; border-radius: 10rpx; display: flex; flex-direction: column; align-items: center; border: 2rpx solid transparent; }
.day-cell.exercised { background: #e4f3e9; }
.day-cell.today .day-number { color: #176b46; font-weight: 800; }
.day-cell.selected { border-color: #176b46; }
.day-number { font-size: 25rpx; line-height: 1.1; }
.weight-number { margin-top: 9rpx; color: #405149; font-size: 19rpx; font-weight: 700; white-space: nowrap; }
.exercise-dot { position: absolute; bottom: 8rpx; width: 12rpx; height: 12rpx; border-radius: 50%; background: #159447; }
.photo-mark { position: absolute; top: 7rpx; right: 7rpx; width: 10rpx; height: 10rpx; border: 2rpx solid #a87519; border-radius: 2rpx; }
.legend { display: flex; justify-content: center; gap: 30rpx; margin-top: 16rpx; color: #68766f; font-size: 21rpx; }
.legend view { display: flex; align-items: center; gap: 8rpx; }
.legend-dot { width: 13rpx; height: 13rpx; border-radius: 50%; background: #159447; }.legend-photo { width: 13rpx; height: 13rpx; border: 2rpx solid #a87519; border-radius: 2rpx; }
.record-card, .trend-card { margin-top: 24rpx; padding: 28rpx; }
.record-heading, .trend-heading, .exercise-row { display: flex; align-items: center; justify-content: space-between; gap: 20rpx; }
.record-date, .trend-title { display: block; font-size: 34rpx; font-weight: 740; }
.record-caption, .trend-copy, .field-hint { display: block; color: #68766f; font-size: 22rpx; margin-top: 6rpx; }
.saved-badge { padding: 9rpx 14rpx; border-radius: 8rpx; background: #e7f1eb; color: #176b46; font-size: 22rpx; font-weight: 700; }
.weight-row { display: grid; grid-template-columns: 1fr 150rpx; gap: 20rpx; margin: 30rpx 0; }
.field-label { display: block; font-weight: 700; margin-bottom: 10rpx; }
.weight-input, .duration-field { min-height: 84rpx; padding: 0 18rpx; border: 1rpx solid #cfd8d1; border-radius: 10rpx; display: flex; align-items: center; gap: 10rpx; }
.weight-input input, .duration-field input { flex: 1; min-width: 0; font-size: 32rpx; }
.photo-button { height: 128rpx; border-radius: 10rpx; overflow: hidden; border: 1rpx dashed #9eb3a5; display: flex; align-items: center; justify-content: center; color: #176b46; font-size: 23rpx; }
.photo-button image { width: 100%; height: 100%; }
.photo-wrap { position: relative; }.remove-photo { min-height: 50rpx; display: flex; align-items: center; justify-content: center; color: #a34b37; font-size: 22rpx; }
.exercise-row { min-height: 100rpx; border-top: 1rpx solid #e5eae6; border-bottom: 1rpx solid #e5eae6; }
.exercise-fields { padding: 22rpx 0; display: grid; grid-template-columns: 1fr 180rpx; gap: 14rpx; }
.picker-field { min-height: 84rpx; padding: 0 18rpx; border: 1rpx solid #cfd8d1; border-radius: 10rpx; display: flex; align-items: center; }
.intensity { grid-column: 1 / -1; display: grid; grid-template-columns: repeat(3,1fr); gap: 8rpx; padding: 8rpx; border-radius: 10rpx; background: #edf0ed; }
.intensity view { min-height: 70rpx; display: flex; align-items: center; justify-content: center; border-radius: 8rpx; color: #68766f; font-size: 25rpx; }.intensity view.active { background: #176b46; color: #fff; }
.note { width: 100%; min-height: 86rpx; margin: 24rpx 0; padding: 20rpx; border-radius: 10rpx; background: #f5f7f2; line-height: 1.55; }
.trend-heading { align-items: flex-start; }
.trend-switch { display: grid; grid-template-columns: 1fr 1fr; padding: 6rpx; gap: 6rpx; background: #edf0ed; border-radius: 9rpx; flex: none; }
.trend-switch view { min-height: 60rpx; padding: 0 14rpx; display: flex; align-items: center; justify-content: center; color: #68766f; font-size: 22rpx; border-radius: 7rpx; }.trend-switch view.active { background: #fff; color: #176b46; font-weight: 700; }
.metric-switch { display: grid; grid-template-columns: 1fr 1fr; gap: 10rpx; margin-top: 22rpx; }
.metric-switch view { min-height: 72rpx; display: flex; align-items: center; justify-content: center; border: 1rpx solid #cfd8d1; border-radius: 9rpx; color: #68766f; font-size: 24rpx; font-weight: 650; }.metric-switch view.active { background: #176b46; color: #fff; border-color: #176b46; }
.weight-chart { width: 640rpx; height: 280rpx; margin-top: 26rpx; }
.exercise-summary { display: grid; grid-template-columns: repeat(4, 1fr); gap: 8rpx; padding-top: 22rpx; border-top: 1rpx solid #e5eae6; }
.exercise-summary view { min-width: 0; text-align: center; }.summary-value { display: block; color: #176b46; font-size: 31rpx; font-weight: 760; }.summary-label { display: block; margin-top: 5rpx; color: #68766f; font-size: 19rpx; line-height: 1.35; }
