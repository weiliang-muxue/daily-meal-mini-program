<view class="preview-page">
  <button class="page-navigation" bindtap="navigateFromPage" hover-class="page-navigation-pressed" aria-label="{{pageNavigationLabel}}">
    <view class="page-navigation-icon {{canNavigateBack ? 'back' : 'home'}}" aria-hidden="true"></view>
  </button>
  <view wx:if="{{viewState === 'loading'}}" class="state-panel" aria-label="正在加载候选餐单">
    <view class="loading-line wide"></view>
    <view class="loading-line"></view>
    <view class="loading-block"></view>
    <text class="state-copy">正在读取候选餐单</text>
  </view>

  <view wx:elif="{{viewState === 'error'}}" class="state-panel" aria-role="alert">
    <text class="state-title">候选餐单暂时无法加载</text>
    <text class="state-copy">{{errorMessage}}</text>
    <button class="primary-action state-action" bindtap="retry" hover-class="button-pressed">重新加载</button>
  </view>

  <view wx:elif="{{viewState === 'no-draft'}}" class="state-panel">
    <text class="state-title">暂无待确认餐单</text>
    <text class="state-copy">选择餐次、目标和运动安排后，即可生成餐单。</text>
    <button class="primary-action state-action" bindtap="backToPlanner" hover-class="button-pressed">返回调整条件</button>
  </view>

  <block wx:else>
    <view wx:if="{{offline}}" class="offline-strip touch-target" bindtap="retry" hover-class="button-pressed" aria-role="button" aria-label="当前显示已保存内容，点此重试连接">
      <text>当前显示已保存内容，确认前请重新连接</text>
    </view>

      <view class="hero-section">
      <text class="eyebrow">{{replacementMode ? '单餐替换预览' : '待确认餐单'}}</text>
      <text class="page-title">{{plan.title}}</text>
      <text class="date-range">{{plan.dateRange}}</text>
      <view class="meta-row">
        <text>{{plan.versionText}}</text>
        <text>生成于 {{plan.generatedText}}</text>
      </view>
        <text class="safety-note">{{replacementMode ? '确认后只替换这一餐并同步采购。其他日期、餐次、定制偏好和历史记录不变。' : '确认后才会替换当前餐单。网络失败或其他设备已更新时，当前餐单保持不变。'}}</text>
      </view>

      <view wx:if="{{replacementError}}" class="section-block" aria-role="alert">
        <text class="section-title">这份单餐候选暂不能使用</text>
        <text class="meal-method">{{replacementError}}</text>
        <text class="meal-method">请重新连接核对；若原餐已修改，可丢弃候选后从当前餐单重新选择。原餐仍然保留。</text>
        <button class="secondary-action" bindtap="retry" disabled="{{busyAction}}">重新连接核对</button>
      </view>
      <view wx:if="{{replacementPreview}}" class="section-block replacement-comparison">
        <text class="section-title">{{replacementPreview.label}}</text>
        <view class="comparison-meal">
          <text class="meal-label">现在这一餐</text>
          <text class="comparison-title">{{replacementPreview.original.title}}</text>
          <text class="meal-method">{{replacementPreview.original.ingredients}}</text>
          <text class="meal-method">做法：{{replacementPreview.original.method}}</text>
        </view>
        <view class="comparison-meal">
          <text class="meal-label">确认后换成</text>
          <text class="comparison-title">{{replacementPreview.candidate.title}}</text>
          <text class="meal-method">{{replacementPreview.candidate.ingredients}}</text>
          <text class="meal-method">做法：{{replacementPreview.candidate.method}}</text>
        </view>
        <text wx:if="{{replacementPreview.modeNote}}" class="meal-method">{{replacementPreview.modeNote}}</text>
        <text wx:if="{{replacementPreview.targetMealTitle}}" class="meal-method">将更新原备选餐“{{replacementPreview.targetMealTitle}}”，并切换为新晚餐。</text>
        <text class="section-title comparison-heading">采购会怎样变化</text>
        <view wx:for="{{replacementPreview.changes}}" wx:key="id" class="purchase-change">
          <text>{{item.name}}</text>
          <text class="purchase-amount">{{item.before}} → {{item.after}}</text>
        </view>
        <text wx:if="{{!replacementPreview.changes.length}}" class="meal-method">采购数量不变。</text>
        <text class="meal-method">{{replacementPreview.checkedReset ? replacementPreview.checkedReset + ' 项采购勾选需重新确认。' : '现有采购勾选保留。'}}未受影响的勾选不会重置。</text>
      </view>

      <view wx:if="{{plan.isAiGenerated}}" class="ai-origin-notice" aria-label="AI 生成内容">
        <text class="ai-origin-badge">AI 生成</text>
        <text class="ai-origin-copy">这份候选餐单由人工智能生成，请核对食材、份量和个人约束后再确认。</text>
      </view>

      <view wx:if="{{plan.basisRows.length}}" class="section-block">
      <text class="section-title">生成依据</text>
      <view class="basis-list">
        <view wx:for="{{plan.basisRows}}" wx:key="label" class="basis-row">
          <text class="basis-label">{{item.label}}</text>
          <text class="basis-value">{{item.value}}</text>
        </view>
      </view>
    </view>

    <view wx:if="{{plan.rationale.length}}" class="section-block rationale-section">
      <text class="section-title">推荐说明</text>
      <view wx:for="{{plan.rationale}}" wx:key="*this" class="rationale-row">
        <view class="rationale-mark"></view>
        <text>{{item}}</text>
      </view>
    </view>

    <view wx:if="{{!replacementMode}}" class="section-block days-section">
      <view class="section-heading">
        <text class="section-title">全部餐单</text>
        <text class="section-count">{{plan.days.length}} 天</text>
      </view>
      <view wx:for="{{plan.days}}" wx:key="key" class="day-block">
        <view class="day-heading">
          <view class="day-index">{{index + 1}}</view>
          <view class="day-copy">
            <text class="day-title">{{item.heading}}</text>
            <text wx:if="{{item.theme}}" class="day-theme">{{item.theme}}</text>
          </view>
        </view>
        <text class="exercise-note">运动安排：{{item.exerciseText}}</text>
        <view class="meal-list">
          <view wx:for="{{item.meals}}" wx:for-item="meal" wx:key="key" class="meal-block">
            <view class="meal-heading">
              <text class="meal-label">{{meal.displayLabel}}</text>
              <text class="meal-title">{{meal.title}}</text>
            </view>
            <view wx:if="{{meal.ingredientItems.length}}" class="ingredient-list">
              <text wx:for="{{meal.ingredientItems}}" wx:for-item="ingredient" wx:key="*this" class="ingredient-item">{{ingredient}}</text>
            </view>
            <text wx:if="{{meal.quantityBasis === 'total'}}" class="meal-method">{{meal.servings}} 人总用量 · 预计 {{meal.estimatedCookingMinutes}} 分钟（含备料，仅为估计）</text>
            <text wx:if="{{meal.method}}" class="meal-method">做法：{{meal.method}}</text>
            <text wx:if="{{meal.tag}}" class="meal-tag">{{meal.tag}}</text>
          </view>
        </view>
      </view>
    </view>

    <view class="action-area">
      <text class="safety-note">仅供日常饮食参考，不能替代医生或注册营养师建议。存在过敏、疾病或治疗相关限制时，请先咨询专业人员。</text>
      <button class="primary-action" loading="{{busyAction === 'confirm'}}" disabled="{{busyAction || offline || replacementError}}" bindtap="confirmPlan" hover-class="button-pressed">{{replacementMode ? '确认，只替换这一餐' : '确认并使用餐单'}}</button>
      <button wx:if="{{!replacementMode}}" class="secondary-action" disabled="{{busyAction}}" bindtap="backToPlanner" hover-class="button-pressed">调整生成条件</button>
      <button class="danger-action" loading="{{busyAction === 'discard'}}" disabled="{{busyAction || offline}}" bindtap="discardPlan" hover-class="button-pressed">{{replacementMode ? '丢弃单餐候选，保留原餐' : '丢弃候选餐单'}}</button>
    </view>
  </block>
</view>
