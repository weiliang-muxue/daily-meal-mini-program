.planner-screen { max-width: 920rpx; margin: 0 auto; padding-bottom: calc(176rpx + constant(safe-area-inset-bottom)); padding-bottom: calc(176rpx + env(safe-area-inset-bottom)); }
.step-head { padding: 10rpx 0 24rpx; }
.step-copy { display: flex; align-items: baseline; justify-content: space-between; gap: 20rpx; }
.step-count { color: var(--primary); font-size: 24rpx; font-weight: 700; }
.step-title { min-width: 0; color: var(--ink); font-size: 32rpx; line-height: 1.35; font-weight: 750; text-align: right; overflow-wrap: anywhere; }
.step-track { display: grid; grid-template-columns: repeat(6, 1fr); gap: 10rpx; margin-top: 20rpx; }
.step-segment { height: 8rpx; border-radius: 4rpx; background: var(--line); }
.step-segment.done, .step-segment.current { background: var(--primary); }
.status-action { margin-top: 24rpx; }
.error-panel { border-color: var(--danger-line); }
.service-strip { display: flex; align-items: center; gap: 16rpx; min-height: 88rpx; padding: 18rpx 20rpx; border: 1rpx solid var(--line-strong); border-radius: 12rpx; background: var(--primary-soft); }
.service-strip.error, .service-strip.unconfigured { border-color: var(--danger-line); background: var(--danger-soft); }
.service-strip.loading { background: var(--surface-muted); }
.service-indicator { width: 14rpx; height: 14rpx; flex: none; border-radius: 50%; background: var(--primary); }
.service-strip.error .service-indicator, .service-strip.unconfigured .service-indicator { background: var(--warm); }
.service-strip.loading .service-indicator { background: var(--muted); }
.service-copy { min-width: 0; flex: 1; }
.service-title { display: block; font-size: 25rpx; line-height: 1.4; font-weight: 700; }
.service-detail { display: block; margin-top: 3rpx; color: var(--muted); font-size: 22rpx; line-height: 1.45; overflow-wrap: anywhere; }
.service-retry { min-width: 100rpx; min-height: 88rpx; margin: -18rpx -14rpx -18rpx 0; padding: 0 16rpx; display: flex; align-items: center; justify-content: center; background: transparent; color: var(--primary); font-size: 25rpx; font-weight: 700; }
.step-body { padding-top: 36rpx; }
.section-heading { display: block; font-size: 38rpx; line-height: 1.3; font-weight: 750; overflow-wrap: anywhere; }
.section-description { display: block; margin-top: 10rpx; color: var(--muted); font-size: 26rpx; line-height: 1.6; }
.option-list, .double-dinner { display: block; margin-top: 28rpx; }
.option-row { min-height: 104rpx; padding: 18rpx 22rpx; margin-bottom: 16rpx; display: flex; align-items: center; gap: 20rpx; border: 1rpx solid var(--line); border-radius: 12rpx; background: var(--surface); }
.option-row.selected { border-color: var(--line-strong); background: var(--primary-soft); }
.option-copy { min-width: 0; flex: 1; }
.option-title { display: block; font-size: 29rpx; line-height: 1.4; font-weight: 700; overflow-wrap: anywhere; }
.option-detail { display: block; margin-top: 5rpx; color: var(--muted); font-size: 23rpx; line-height: 1.45; overflow-wrap: anywhere; }
.option-row checkbox { flex: none; transform: scale(.92); }
.segmented { display: grid; grid-template-columns: 1fr 1fr; gap: 12rpx; margin-top: 30rpx; padding: 8rpx; border-radius: 14rpx; background: var(--surface-muted); }
.segment { min-height: 88rpx; margin: 0; padding: 0 18rpx; display: flex; align-items: center; justify-content: center; border-radius: 10rpx; background: transparent; color: var(--muted); font-size: 28rpx; font-weight: 700; }
.segment.selected { background: var(--surface); color: var(--primary); box-shadow: 0 2rpx 8rpx var(--shadow-soft); }
.field-block { margin-top: 30rpx; }
.field-label { display: block; margin-bottom: 12rpx; color: var(--ink); font-size: 26rpx; line-height: 1.4; font-weight: 700; }
.group-label { margin-top: 30rpx; }
.date-picker, .compact-field input { min-height: 92rpx; padding: 0 22rpx; display: flex; align-items: center; justify-content: space-between; gap: 20rpx; border: 1rpx solid var(--line-strong); border-radius: 10rpx; background: var(--input-surface); color: var(--ink); font-size: 28rpx; }
.field-action { color: var(--primary); font-weight: 700; }
.choice-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 14rpx; }
.choice { min-height: 88rpx; padding: 14rpx 16rpx; display: flex; align-items: center; justify-content: center; border: 1rpx solid var(--line); border-radius: 10rpx; background: var(--surface); color: var(--ink); font-size: 26rpx; line-height: 1.35; text-align: center; overflow-wrap: anywhere; }
.choice.selected { border-color: var(--line-strong); background: var(--primary-soft); color: var(--primary); font-weight: 700; }
.visually-hidden { position: absolute; width: 1rpx; height: 1rpx; opacity: 0; pointer-events: none; }
textarea { width: 100%; height: 180rpx; min-height: 180rpx; padding: 20rpx 22rpx; border: 1rpx solid var(--line-strong); border-radius: 10rpx; background: var(--input-surface); color: var(--ink); font-size: 28rpx; line-height: 1.55; }
.field-counter { display: block; margin-top: 8rpx; color: var(--muted); font-size: 22rpx; line-height: 1.45; text-align: right; }
.exercise-list { margin-top: 28rpx; }
.exercise-day { margin-bottom: 16rpx; overflow: hidden; }
.exercise-day.planned { border-color: var(--line-strong); }
.exercise-toggle { width: 100%; min-height: 104rpx; margin: 0; padding: 16rpx 22rpx; display: flex; align-items: center; justify-content: space-between; gap: 20rpx; background: transparent; color: var(--ink); text-align: left; }
.exercise-date { min-width: 0; flex: 1; }
.exercise-label { display: block; font-size: 28rpx; line-height: 1.4; font-weight: 700; }
.exercise-date-text { display: block; margin-top: 4rpx; color: var(--muted); font-size: 23rpx; }
.exercise-state { flex: none; color: var(--muted); font-size: 24rpx; }
.planned .exercise-state { color: var(--primary); font-weight: 700; }
.exercise-fields { padding: 2rpx 22rpx 24rpx; border-top: 1rpx solid var(--line); }
.compact-field { margin-top: 20rpx; }
.compact-field input { justify-content: flex-start; }
.intensity-row { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 10rpx; margin-top: 20rpx; }
.intensity { min-height: 88rpx; margin: 0; padding: 0 8rpx; display: flex; align-items: center; justify-content: center; border: 1rpx solid var(--line); border-radius: 10rpx; background: var(--surface); color: var(--muted); font-size: 24rpx; }
.intensity.selected { border-color: var(--line-strong); background: var(--primary-soft); color: var(--primary); font-weight: 700; }
.summary { margin-top: 28rpx; overflow: hidden; }
.summary-row { min-height: 88rpx; padding: 18rpx 22rpx; display: flex; align-items: flex-start; gap: 20rpx; border-bottom: 1rpx solid var(--line); }
.summary-row:last-child { border-bottom: 0; }
.summary-label { width: 86rpx; flex: none; color: var(--muted); font-size: 25rpx; line-height: 1.5; }
.summary-value { min-width: 0; flex: 1; font-size: 26rpx; line-height: 1.5; text-align: right; overflow-wrap: anywhere; }
.task-panel { min-height: 600rpx; margin-top: 28rpx; padding: 26rpx 22rpx 22rpx; overflow: hidden; }
.task-head { display: flex; align-items: flex-start; gap: 20rpx; }
.task-copy { min-width: 0; flex: 1; }
.task-title { display: block; color: var(--ink); font-size: 30rpx; line-height: 1.4; font-weight: 750; overflow-wrap: anywhere; }
.task-detail { display: block; min-height: 76rpx; margin-top: 8rpx; color: var(--muted); font-size: 24rpx; line-height: 1.55; overflow-wrap: anywhere; }
.task-percent { flex: none; color: var(--primary); font-size: 30rpx; line-height: 1.4; font-weight: 750; font-variant-numeric: tabular-nums; }
.progress-track { width: 100%; height: 12rpx; margin-top: 24rpx; overflow: hidden; border-radius: 6rpx; background: var(--surface-muted); }
.progress-fill { height: 100%; border-radius: 6rpx; background: var(--primary-fill); transition: width 220ms ease-out; }
.task-stages { margin-top: 26rpx; border-top: 1rpx solid var(--line); }
.task-stage { min-height: 112rpx; padding: 18rpx 0; display: flex; align-items: center; gap: 16rpx; border-bottom: 1rpx solid var(--line); }
.stage-marker { width: 48rpx; height: 48rpx; flex: none; display: flex; align-items: center; justify-content: center; border: 1rpx solid var(--line-strong); border-radius: 50%; background: var(--surface); color: var(--muted); font-size: 22rpx; font-weight: 700; }
.stage-copy { min-width: 0; flex: 1; }
.stage-label { display: block; color: var(--ink); font-size: 26rpx; line-height: 1.4; font-weight: 700; }
.stage-detail { display: block; margin-top: 3rpx; color: var(--muted); font-size: 22rpx; line-height: 1.45; overflow-wrap: anywhere; }
.stage-state { width: 92rpx; flex: none; color: var(--muted); font-size: 22rpx; line-height: 1.4; text-align: right; }
.task-stage.current .stage-marker, .task-stage.done .stage-marker { border-color: var(--primary); background: var(--primary-soft); color: var(--primary); }
.task-stage.current .stage-state, .task-stage.done .stage-state { color: var(--primary); font-weight: 700; }
.task-stage.error .stage-marker { border-color: var(--danger-line); background: var(--danger-soft); color: var(--danger); }
.task-stage.error .stage-state { color: var(--danger); font-weight: 700; }
.task-stage.cancelled .stage-marker { border-color: var(--warm-line); background: var(--warm-soft); color: var(--warm-ink); }
.task-stage.cancelled .stage-state { color: var(--warm-ink); font-weight: 700; }
.task-boundary { margin-top: 22rpx; padding: 18rpx 20rpx; border-left: 6rpx solid var(--gold); background: var(--gold-soft); color: var(--gold-ink); font-size: 22rpx; line-height: 1.55; }
.privacy-box { margin-top: 24rpx; padding: 24rpx; border-left: 6rpx solid var(--gold); background: var(--gold-soft); color: var(--gold-ink); font-size: 24rpx; line-height: 1.6; }
.privacy-title { display: block; color: var(--gold-ink); font-weight: 750; }
.privacy-copy { display: block; margin-top: 6rpx; }
.inline-error { margin-top: 24rpx; padding: 20rpx 22rpx; border: 1rpx solid var(--danger-line); border-radius: 10rpx; background: var(--danger-soft); color: var(--danger); font-size: 25rpx; line-height: 1.5; }
.error-retry { min-height: 88rpx; margin: 8rpx 0 -16rpx; padding: 0; display: flex; align-items: center; justify-content: flex-start; background: transparent; color: var(--danger); font-size: 25rpx; font-weight: 700; }
.bottom-actions { position: fixed; left: 0; right: 0; bottom: 0; z-index: 10; min-height: 132rpx; padding: 18rpx 28rpx calc(18rpx + constant(safe-area-inset-bottom)); padding-bottom: calc(18rpx + env(safe-area-inset-bottom)); display: flex; gap: 16rpx; border-top: 1rpx solid var(--line); background: var(--surface); }
.bottom-actions .back-button { width: 210rpx; flex: none; margin: 0; }
.bottom-actions .next-button { min-width: 0; flex: 1; margin: 0; }
.bottom-actions .task-action { min-width: 0; flex: 1; margin: 0; }
.danger-button { min-height: 92rpx; border: 1rpx solid var(--danger-line); border-radius: 14rpx; display: flex; align-items: center; justify-content: center; background: var(--danger-soft); color: var(--danger); font-size: 30rpx; font-weight: 650; }
.danger-button[disabled] { opacity: .48; }
.row-hover, .button-hover { opacity: .78; }
@media (min-width: 900px) {
  .planner-screen { padding-left: 40rpx; padding-right: 40rpx; }
  .bottom-actions { padding-left: calc((100vw - 840rpx) / 2); padding-right: calc((100vw - 840rpx) / 2); }
}
@media (max-width: 340px), (orientation: landscape) and (max-height: 500px) {
  .planner-screen.task-actions-visible { padding-bottom: calc(296rpx + constant(safe-area-inset-bottom)); padding-bottom: calc(296rpx + env(safe-area-inset-bottom)); }
  .choice-grid { grid-template-columns: minmax(0, 1fr); }
  .summary-row { display: block; }
  .summary-label { width: auto; }
  .summary-value { margin-top: 6rpx; text-align: left; }
  .task-head { display: block; }
  .task-percent { display: block; margin-top: 10rpx; }
  .bottom-actions.task-layout { min-height: 252rpx; flex-wrap: wrap; align-content: center; }
  .bottom-actions .task-action { flex: 1 1 280rpx; font-size: 26rpx; }
}
@media (max-width: 400px) {
  .option-row, .date-picker, .choice { min-height: 48px; }
}
@media (prefers-reduced-motion: reduce) {
  .progress-fill { transition: none; }
}
