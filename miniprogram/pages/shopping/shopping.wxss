.heading-row { display: flex; justify-content: space-between; align-items: flex-end; padding: 12rpx 4rpx 26rpx; }
.eyebrow { display: block; color: #a87519; font-size: 24rpx; font-weight: 700; margin-bottom: 7rpx; }
.page-title { display: block; font-size: 48rpx; line-height: 1.2; font-weight: 780; }
.progress { text-align: right; }
.progress-number { display: block; color: #176b46; font-size: 36rpx; font-weight: 750; }
.progress-label { display: block; color: #68766f; font-size: 22rpx; }
.offline-strip, .saving-strip { padding: 20rpx; border-radius: 10rpx; margin-bottom: 22rpx; font-size: 24rpx; }
.offline-strip { background: #fff0e9; color: #8a4736; }
.saving-strip { background: #e7f1eb; color: #37604c; }
.group { margin-bottom: 22rpx; overflow: hidden; }
.group-heading { min-height: 88rpx; padding: 0 26rpx; display: flex; align-items: center; justify-content: space-between; border-bottom: 1rpx solid #e4eae5; }
.group-title { font-size: 31rpx; font-weight: 730; }
.group-count { color: #68766f; font-size: 24rpx; }
.shopping-row { min-height: 112rpx; padding: 20rpx 26rpx; display: flex; align-items: center; gap: 22rpx; border-bottom: 1rpx solid #edf0ed; }
.shopping-row:last-child { border-bottom: 0; }
.checkbox { flex: none; width: 46rpx; height: 46rpx; border: 2rpx solid #aab7af; border-radius: 8rpx; display: flex; align-items: center; justify-content: center; color: #fff; font-weight: 800; }
.checked .checkbox { background: #176b46; border-color: #176b46; }
.food-copy { flex: 1; min-width: 0; display: flex; justify-content: space-between; align-items: center; gap: 18rpx; }
.food-name { font-size: 29rpx; font-weight: 620; }
.food-amount { color: #68766f; font-size: 25rpx; text-align: right; }
.checked .food-name { color: #87918b; text-decoration: line-through; }
.row-hover { background: #f2f6f2; }
.reset-button { margin: 32rpx 0 12rpx; }
.group-skeleton { height: 360rpx; border-radius: 16rpx; margin-bottom: 22rpx; }
