page { background: var(--background); color: var(--ink); }
button { letter-spacing: 0; }
.history-page {
  box-sizing: border-box; width: 100%; max-width: 680px; min-height: 100vh; margin: 0 auto;
  padding: 28rpx 28rpx 40rpx;
  padding-right: calc(28rpx + constant(safe-area-inset-right));
  padding-bottom: calc(40rpx + constant(safe-area-inset-bottom));
  padding-left: calc(28rpx + constant(safe-area-inset-left));
  padding-right: calc(28rpx + env(safe-area-inset-right));
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
  padding-left: calc(28rpx + env(safe-area-inset-left));
}
.page-navigation { box-sizing: border-box; width: 48px; min-width: 48px; max-width: 48px; height: 48px; min-height: 48px; margin: 0 0 12rpx; padding: 0; display: flex; align-items: center; justify-content: center; border: 1rpx solid var(--line-strong); border-radius: 50%; background: var(--surface); color: var(--primary); }
.page-navigation::after { border: 0; }
.page-navigation-pressed { background: var(--pressed); opacity: .78; }
.page-navigation-icon { position: relative; width: 24px; height: 24px; color: inherit; }
.page-navigation-icon.back::before { content: ""; position: absolute; left: 5px; top: 6px; width: 10px; height: 10px; border-bottom: 2px solid currentColor; border-left: 2px solid currentColor; transform: rotate(45deg); }
.page-navigation-icon.back::after { content: ""; position: absolute; left: 6px; top: 11px; width: 14px; height: 2px; border-radius: 1px; background: currentColor; }
.page-navigation-icon.home::before { content: ""; position: absolute; left: 6px; top: 3px; width: 11px; height: 11px; border-top: 2px solid currentColor; border-left: 2px solid currentColor; transform: rotate(45deg); }
.page-navigation-icon.home::after { content: ""; position: absolute; left: 5px; bottom: 3px; width: 14px; height: 11px; border: 2px solid currentColor; border-top: 0; border-radius: 0 0 2px 2px; }
.page-heading { padding: 10rpx 2rpx 26rpx 20rpx; border-left: 6rpx solid var(--line-strong); }
.page-title { display: block; font-size: 24px; line-height: 1.3; font-weight: 760; }
.page-copy { display: block; margin-top: 12rpx; color: var(--muted); font-size: 25rpx; line-height: 1.65; overflow-wrap: anywhere; }
.offline-strip { box-sizing: border-box; min-height: 88rpx; margin-bottom: 18rpx; padding: 18rpx 20rpx; display: flex; align-items: center; border: 1rpx solid var(--warm-line); border-radius: 8rpx; background: var(--warm-soft); color: var(--warm-ink); font-size: 24rpx; line-height: 1.5; overflow-wrap: anywhere; }
.history-list { display: grid; gap: 22rpx; }
.history-item { overflow: hidden; border: 1rpx solid var(--line); border-radius: 8rpx; background: var(--surface); }
.plan-summary { padding: 26rpx 26rpx 20rpx; }
.summary-heading { display: flex; flex-wrap: wrap; align-items: flex-start; justify-content: space-between; gap: 12rpx 20rpx; }
.plan-title { min-width: 0; flex: 1; font-size: 16px; line-height: 1.4; font-weight: 740; overflow-wrap: anywhere; }
.source-badge { flex: none; max-width: 100%; padding: 7rpx 11rpx; border-radius: 6rpx; background: var(--surface-muted); color: var(--muted-strong); font-size: 21rpx; line-height: 1.45; font-weight: 700; overflow-wrap: anywhere; }
.date-range { display: block; margin-top: 13rpx; color: var(--muted-strong); font-size: 25rpx; line-height: 1.5; overflow-wrap: anywhere; }
.meta-row { display: flex; flex-wrap: wrap; gap: 7rpx 22rpx; margin-top: 15rpx; color: var(--muted); font-size: 22rpx; line-height: 1.5; }
.expand-action, .restore-action, .primary-action { box-sizing: border-box; width: calc(100% - 52rpx); min-height: 96rpx; margin: 0 26rpx 18rpx; padding: 16rpx 22rpx; display: flex; align-items: center; justify-content: center; border-radius: var(--radius-control); font-size: 26rpx; line-height: 1.4; font-weight: 700; transition: opacity .18s ease, background-color .18s ease; }
.expand-action { border: 1rpx solid var(--line-strong); background: var(--surface); color: var(--muted-strong); }
.restore-action, .primary-action { background: var(--primary-fill); color: var(--on-primary); }
.expand-action::after, .restore-action::after, .primary-action::after { border: 0; }
.restore-action[disabled] { opacity: .5; }
.button-pressed { opacity: .76; }
.day-overview { margin: 0 26rpx 20rpx; border-top: 1rpx solid var(--line); }
.day-row { padding: 20rpx 0; border-bottom: 1rpx solid var(--line); }
.day-row:last-child { border-bottom: 0; }
.day-title { display: block; font-size: 26rpx; line-height: 1.5; font-weight: 700; overflow-wrap: anywhere; }
.meal-overview { margin-top: 12rpx; display: grid; gap: 10rpx; }
.meal-row { display: grid; grid-template-columns: minmax(120rpx, 170rpx) minmax(0, 1fr); gap: 14rpx; align-items: start; }
.meal-label { color: var(--primary); font-size: 22rpx; line-height: 1.5; font-weight: 700; overflow-wrap: anywhere; }
.meal-title { min-width: 0; color: var(--muted-strong); font-size: 23rpx; line-height: 1.5; overflow-wrap: anywhere; }
.state-panel { box-sizing: border-box; min-height: 560rpx; padding: 80rpx 34rpx; display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; }
.state-title { display: block; font-size: 34rpx; line-height: 1.4; font-weight: 750; }
.state-copy { display: block; max-width: 600rpx; margin-top: 16rpx; color: var(--muted); font-size: 25rpx; line-height: 1.65; overflow-wrap: anywhere; }
.state-action { width: 100%; margin-top: 30rpx; }
.loading-line, .loading-block { overflow: hidden; background: var(--skeleton); }
.loading-line { width: 55%; height: 30rpx; margin-top: 18rpx; border-radius: 6rpx; }
.loading-line.wide { width: 82%; height: 48rpx; margin-top: 0; }
.loading-block { width: 100%; max-width: 620rpx; height: 230rpx; margin-top: 30rpx; border-radius: 8rpx; }
@media (min-width: 700px) {
  .history-page {
    padding-left: calc(48rpx + constant(safe-area-inset-left));
    padding-right: calc(48rpx + constant(safe-area-inset-right));
    padding-left: calc(48rpx + env(safe-area-inset-left));
    padding-right: calc(48rpx + env(safe-area-inset-right));
  }
}
@media (max-width: 340px), (orientation: landscape) and (max-height: 500px) {
  .plan-summary { padding-left: 20rpx; padding-right: 20rpx; }
  .expand-action, .restore-action, .primary-action { width: calc(100% - 40rpx); margin-left: 20rpx; margin-right: 20rpx; }
  .day-overview { margin-left: 20rpx; margin-right: 20rpx; }
  .meal-row { grid-template-columns: minmax(0, 1fr); gap: 2rpx; }
}
@media (max-width: 400px) {
  .offline-strip { min-height: 48px; }
}
