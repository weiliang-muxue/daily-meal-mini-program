# Configure these values only in the WeChat cloud-function environment-variable UI.
# Never put a real value in this file or Git.
AI_API_KEY=YOUR_AI_API_KEY

# Non-secret provider identity. The defaults shown here match provider contract v9.
# Rotate only AI_API_KEY for the same provider. When the URL or receiving provider
# changes, increase AI_PROVIDER_REVISION so existing tasks require fresh consent.
AI_API_BASE_URL=https://www.modelhub.shop
AI_PROVIDER_DISPLAY_NAME=ModelHub AI 服务
AI_PROVIDER_REVISION=8

# Provider contract v9 uses the provider's root Responses endpoint with standard Bearer
# authentication only. No provider-specific authentication or compatibility header is sent.

# Optional non-secret resource tuning.
AI_TIMEOUT_MS=45000
AI_MAX_TOKENS=16000
