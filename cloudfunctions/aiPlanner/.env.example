# Copy only AI_API_KEY into the WeChat cloud-function environment-variable UI.
# Never put a real value in this file or Git.
AI_API_KEY=YOUR_AI_API_KEY

# Public production defaults are versioned in provider-config.js:
# endpoint https://gptpro.live/v1/responses, model gpt-5.6, Responses API,
# reasoning effort xhigh, and the provider's non-secret x-* compatibility header.

# Optional migration overrides. Set a full HTTPS endpoint or a base URL, never both.
# AI_API_ENDPOINT=YOUR_AI_HTTPS_ENDPOINT
# AI_BASE_URL=YOUR_AI_HTTPS_BASE_URL
# AI_API_URL is accepted only for older deployments and means a full endpoint.
# AI_MODEL=YOUR_MODEL_NAME
# AI_API_STYLE=responses
# AI_REASONING_EFFORT=xhigh

# Optional provider-specific x-* header. Custom endpoints receive no provider-specific
# header unless both fields below are explicitly configured.
# The cloud function rejects attempts to override Authorization, Host or content headers.
# AI_PROVIDER_HEADER_NAME=X_PROVIDER_HEADER_NAME
# AI_PROVIDER_HEADER_VALUE=YOUR_PROVIDER_HEADER_VALUE

# Optional non-secret tuning. Keep the defaults unless your provider requires changes.
AI_TIMEOUT_MS=45000
AI_MAX_TOKENS=16000
# Leave unset unless the selected model explicitly supports it.
# AI_TEMPERATURE=0.3
