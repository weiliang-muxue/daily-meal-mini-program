# Configure these values only in the WeChat cloud-function environment-variable UI.
# Never put a real value in this file or Git.
AI_API_KEY=YOUR_AI_API_KEY

# Non-secret provider identity. There are no bundled defaults; fill these only
# in the cloud-function environment-variable UI. Rotate only AI_API_KEY for the
# same receiving party. When the endpoint or receiving party changes, increase
# AI_PROVIDER_REVISION so existing tasks require fresh consent.
AI_API_BASE_URL=<YOUR_AI_API_BASE_URL>
AI_PROVIDER_DISPLAY_NAME=<YOUR_AI_PROVIDER_DISPLAY_NAME>
AI_PROVIDER_REVISION=<YOUR_AI_PROVIDER_REVISION>

# Provider contract v9 uses the provider's root Responses endpoint with standard Bearer
# authentication only. No provider-specific authentication or compatibility header is sent.

# Optional non-secret resource tuning.
AI_TIMEOUT_MS=45000
AI_MAX_TOKENS=16000
